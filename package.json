{
  "name": "shijian-workbench",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "dev:site": "vite --config site/vite.config.mjs",
    "typecheck": "vue-tsc --noEmit -p web/tsconfig.json",
    "build": "npm run typecheck && node scripts/build-product-site.mjs",
    "build:web": "npm run typecheck && vite build --config web/vite.config.ts",
    "build:site": "node scripts/build-site.mjs",
    "preview": "vite preview --config web/vite.config.ts",
    "preview:site": "vite preview --config site/vite.config.mjs --port 5181 --strictPort"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "^2.9.1",
    "lucide-vue-next": "^0.577.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}
